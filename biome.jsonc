{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  // FC-GEN-045 is 120 columns. Enforced by the formatter rather than by hand:
  // a hand-wrapped line drifts back the first time someone runs a formatter,
  // and a formatter-produced diff is reproducible — re-running it changes
  // nothing.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  // Import sorting would reorder code, which this is not about.
  "assist": { "enabled": false },
  // Formatting only. The house Biome *rules* are a separate adoption, and
  // switching them on here would mean a pile of findings to fix in what is
  // meant to be a mechanical, reproducible diff.
  "linter": { "enabled": false },
  "files": {
    "includes": [
      "record/**",
      "!**/node_modules/**",
      "!**/dist/**"
    ]
  }
}
